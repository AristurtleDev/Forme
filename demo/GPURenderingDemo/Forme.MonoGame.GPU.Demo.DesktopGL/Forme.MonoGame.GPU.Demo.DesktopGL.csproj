<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Forme.MonoGame.GPU.Demo.Shared\Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Forme.MonoGame.GPU.Demo.Shared\Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Forme.MonoGame.GPU.Demo.Shared\Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Forme.MonoGame.GPU.Demo.Shared\Forme.MonoGame.GPU.Demo.Shared.csproj" />
    <MonoGameContentReference Include="..\Forme.MonoGame.GPU.Demo.Shared\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
      <Platform>DesktopGL</Platform>
    </MonoGameContentReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="$(MonoGameVersion)" />
  </ItemGroup>
</Project>
